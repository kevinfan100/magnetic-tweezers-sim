# ANSYS result files (large, regenerable)
*.rmg
*.esav
*.full
*.rst
*.rth
*.db
*.emat
*.BCS
*.stat
*.r001
*.ldhi
*.mlv
*.page

# ANSYS log/temp files
*.err
*.log
*.out
*.lock
*.mntr

# Results directories
**/results/

# COMSOL files (large binary, not tracked)
hung/comsol/

# MATLAB temp files
*.asv
*.m~

# Reference PDFs (large binary files)
references/pdfs/*.pdf

# Reference text extracts (regenerable from PDFs via pdftotext)
references/texts/

# ANSYS auto-generated cleanup scripts
cleanup-ansys-*.bat
file0.bat

# MCP server config (local)
.mcp.json

# OS files
Thumbs.db
desktop.ini
.DS_Store
.claude/settings.local.json
